---
import ChapterView from '../components/ChapterView.astro';
import { getSortedChapters, chapterSlug } from '../lib/chapters';

export async function getStaticPaths() {
  const chapters = await getSortedChapters('en');
  return chapters.map((entry) => ({
    params: { slug: chapterSlug(entry) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
---

<ChapterView entry={entry} lang="en" />
