---
// One "シェア" button that opens a dropdown of networks (native <details>, no JS
// for open/close). Brand glyphs are inlined from simple-icons (self-hosted, zero
// runtime dependency); LinkedIn is a hand-built mark because its source was
// unreachable here. The "copy link" + OS-native share entries are progressively
// enhanced by a small script. Goal is reach, so the net is wide (JP + Western).
interface Props {
  url: string;
  title: string;
  lang?: 'en' | 'ja';
}
const { url, title, lang = 'en' } = Astro.props;
const enc = encodeURIComponent;
const L = {
  en: { share: 'Share', native: 'Share via an app', copy: 'Copy link', copied: 'Copied ✓' },
  ja: { share: 'シェアする', native: '他のアプリで共有', copy: 'リンクをコピー', copied: 'コピーしました ✓' },
}[lang];

// simple-icons (24x24, single path). Coloured with the brand hue; X uses
// currentColor so it stays visible in dark mode.
