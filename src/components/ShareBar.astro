};

const ic = (path: string, color: string) =>
  `<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="${color}" d="${path}"/></svg>`;

const icons: Record<string, string> = {
  X: ic(P.x, 'currentColor'),
  Facebook: ic(P.facebook, '#1877F2'),
  LinkedIn:
    '<svg viewBox="0 0 24 24" aria-hidden="true"><rect width="24" height="24" rx="4.5" fill="#0A66C2"/><text x="12" y="17.6" text-anchor="middle" font-family="Helvetica, Arial, sans-serif" font-size="13" font-weight="700" fill="#fff">in</text></svg>',
  Reddit: ic(P.reddit, '#FF4500'),
  'Hacker News': ic(P.hn, '#FF6600'),
  LINE: ic(P.line, '#06C755'),
  'はてなブックマーク': ic(P.hatena, '#00A4DE'),
};

const links = [
  { name: 'X', href: `https://x.com/intent/tweet?text=${enc(title)}&url=${enc(url)}` },
  { name: 'Facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${enc(url)}` },
  { name: 'LinkedIn', href: `https://www.linkedin.com/sharing/share-offsite/?url=${enc(url)}` },
  { name: 'Reddit', href: `https://www.reddit.com/submit?url=${enc(url)}&title=${enc(title)}` },
  { name: 'Hacker News', href: `https://news.ycombinator.com/submitlink?u=${enc(url)}&t=${enc(title)}` },
  { name: 'LINE', href: `https://social-plugins.line.me/lineit/share?url=${enc(url)}` },
  { name: 'はてなブックマーク', href: `https://b.hatena.ne.jp/entry/panel/?url=${enc(url)}&title=${enc(title)}` },
];
---

<details class="share" data-share-url={url} data-share-title={title} data-copied={L.copied}>
  <summary class="share__toggle btn">{L.share}</summary>
  <div class="share__menu">
    {
      links.map((l) => (
        <a class="share__item" href={l.href} target="_blank" rel="noopener noreferrer">
          <span class="share__ico" set:html={icons[l.name]} />
          {l.name}
        </a>
      ))
    }
    <button class="share__item" type="button" data-share-native hidden>
      <span class="share__ico" aria-hidden="true">↗</span>{L.native}
    </button>
    <button class="share__item" type="button" data-share-copy>
      <span class="share__ico" aria-hidden="true">🔗</span>{L.copy}
    </button>
  </div>
</details>

<script>
  for (const el of document.querySelectorAll<HTMLDetailsElement>('.share')) {
    const url = el.dataset.shareUrl ?? '';
    const title = el.dataset.shareTitle ?? '';

    const nativeBtn = el.querySelector<HTMLButtonElement>('[data-share-native]');
    if (nativeBtn && typeof navigator.share === 'function') {
      nativeBtn.hidden = false;
      nativeBtn.addEventListener('click', () => {
        el.open = false;
        navigator.share({ title, url }).catch(() => {});
      });
    }

    const copyBtn = el.querySelector<HTMLButtonElement>('[data-share-copy]');
    copyBtn?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(url);
        const prev = copyBtn.textContent;
        copyBtn.textContent = el.dataset.copied ?? 'Copied ✓';
        setTimeout(() => {
          copyBtn.textContent = prev;
          el.open = false;
        }, 1000);
      } catch {
        el.open = false;
      }
    });

    for (const a of el.querySelectorAll('a.share__item')) {
      a.addEventListener('click', () => {
        el.open = false;
      });
    }
    document.addEventListener('click', (e) => {
      if (el.open && e.target instanceof Node && !el.contains(e.target)) {el.open = false;}
    });
    el.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {el.open = false;}
    });
  }
</script>
