---
// One neuron: inputs × weights → sum → a "switch" (activation) → output.
interface Props {
  lang?: 'en' | 'ja';
}
const { lang = 'ja' } = Astro.props;
const S = {
  ja: {
    inputs: '入力',
    weights: '重み（重視度）',
    sum1: '重みを',
    sum2: 'かけて足す',
    switch: 'スイッチ',
    switchSub: '（活性化）',
    output: '出力',
    cap: 'ニューロンは「入力に<strong>重み</strong>をかけて足し、<strong>スイッチ</strong>を通す」だけの部品です。重みが「どの入力をどれだけ重視するか」を決め、スイッチ（活性化）が、ただの足し算では作れない複雑な反応を可能にします。',
  },
  en: {
    inputs: 'inputs',
    weights: 'weights (importance)',
    sum1: 'weight',
    sum2: 'and add',
    switch: 'switch',
    switchSub: '(activation)',
    output: 'output',
    cap: 'A neuron is just a part that "multiplies its <strong>inputs</strong> by <strong>weights</strong>, adds them up, and passes the result through a <strong>switch</strong>." The weights decide "which input matters, and how much," and the switch (activation) makes possible the complex responses that plain addition never could.',
  },
}[lang];
---

<figure class="figure">
  <svg viewBox="0 0 600 220" role="img" aria-label="How one neuron works: multiply inputs by weights, add, pass through a switch">
    <defs>
      <marker id="ah-nu" markerWidth="10" markerHeight="10" refX="7" refY="3" orient="auto">
        <path d="M0,0 L7,3 L0,6 Z" style="fill: var(--fg-muted)"></path>
      </marker>
    </defs>

    <text class="f-mut" x="70" y="26" text-anchor="middle">{S.inputs}</text>
    <text class="f-mut" x="180" y="26" text-anchor="middle">{S.weights}</text>

    <!-- inputs -->
    <circle class="f-box" cx="70" cy="60" r="18"></circle>
    <text class="f-lbl" x="70" y="65" text-anchor="middle">0.5</text>
    <circle class="f-box" cx="70" cy="110" r="18"></circle>
    <text class="f-lbl" x="70" y="115" text-anchor="middle">0.9</text>
    <circle class="f-box" cx="70" cy="160" r="18"></circle>
    <text class="f-lbl" x="70" y="165" text-anchor="middle">0.2</text>

    <!-- weighted edges -->
    <line class="f-axis" x1="90" y1="60" x2="265" y2="105"></line>
    <line class="f-axis" x1="90" y1="110" x2="265" y2="110"></line>
    <line class="f-axis" x1="90" y1="160" x2="265" y2="115"></line>
    <text class="f-mut" x="170" y="64" text-anchor="middle">×0.8</text>
    <text class="f-mut" x="170" y="103" text-anchor="middle">×−0.5</text>
    <text class="f-mut" x="170" y="156" text-anchor="middle">×0.3</text>

    <!-- sum -->
    <circle class="f-box" cx="295" cy="110" r="30"></circle>
    <text class="f-lbl" x="295" y="106" text-anchor="middle">{S.sum1}</text>
    <text class="f-lbl" x="295" y="122" text-anchor="middle">{S.sum2}</text>

    <line class="f-axis" x1="327" y1="110" x2="372" y2="110" marker-end="url(#ah-nu)"></line>

    <!-- activation gate -->
    <rect class="f-box" x="382" y="86" width="92" height="48" rx="8"></rect>
    <text class="f-lbl" x="428" y="106" text-anchor="middle">{S.switch}</text>
    <text class="f-mut" x="428" y="123" text-anchor="middle">{S.switchSub}</text>

    <line class="f-axis" x1="476" y1="110" x2="518" y2="110" marker-end="url(#ah-nu)"></line>

    <!-- output -->
    <circle class="f-dot" cx="545" cy="110" r="9"></circle>
    <text class="f-mut" x="545" y="140" text-anchor="middle">{S.output}</text>
  </svg>
  <figcaption set:html={S.cap} />
</figure>
