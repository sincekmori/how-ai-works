---
// What BPE leaves behind after training: the list of pieces (the vocabulary)
// AND an ordered list of merge rules. New text is split by replaying the rules
// in that order, so both are needed at the time of use.
import { CHIP_H, chipsFrom } from '../../lib/chips';

interface Props {
  lang?: 'en' | 'ja';
}
const { lang = 'ja' } = Astro.props;

const S = {
  ja: {
    aria: 'BPE の学習が残す二つのもの：部品の一覧表と、順番つきの結合ルール。新しい文章はその順番でルールを当てはめて区切る',
    train: ['学習データで', 'くっつけを繰り返す'],
    vocabTitle: '部品の一覧表（語彙）',
    vocab: ['東', '京', '…', '東京', '京都'],
    rulesTitle: '結合ルール（順番つき）',
    rules: ['1. 東 ＋ 京 → 東京', '2. 京 ＋ 都 → 京都'],
    use: ['新しい文章を区切る', '1 文字ずつに分けてから、', 'ルールを 1 番から順に', '当てはめる'],
    cap: 'くっつけを繰り返し終わると、部品の一覧表と、順番つきの結合ルールが残ります。新しい文章は、まず 1 文字ずつに分け、ルールを覚えたときと同じ順番で当てはめて区切ります。',
  },
  en: {
    aria: 'What BPE training leaves behind: the list of pieces and an ordered list of merge rules; new text is split by replaying the rules in that order',
    train: ['On the training text:', 'glue, repeat'],
    vocabTitle: 'list of pieces (vocabulary)',
    vocab: ['t', 'h', '…', 'at', 'th', 'the'],
    rulesTitle: 'merge rules (in order)',
    rules: ['1. a + t → at', '2. t + h → th', '3. th + e → the'],
    use: ['Splitting new text', 'split into characters,', 'then apply the rules', 'in order from rule 1'],
    cap: 'When the gluing is finished, two things remain: the list of pieces and the merge rules in the order they were learned. New text is split by starting from single characters and replaying the rules in exactly that order.',
  },
}[lang];

const LEFT = { x: 16, y: 72, w: 118, h: 100 };
const MID = { x: 166, w: 262 };
const TOP = { y: 16, h: 86 };
const BOT = { y: 116, h: 110 };
const RIGHT = { x: 460, y: 60, w: 124, h: 124 };
const vocabChips = chipsFrom(S.vocab, MID.x + 12, 5);
---

<figure class="figure">
  <svg viewBox="0 0 600 240" role="img" aria-label={S.aria}>
    <rect class="f-box" x={LEFT.x} y={LEFT.y} width={LEFT.w} height={LEFT.h} rx="12"></rect>
    <text class="f-mut" x={LEFT.x + LEFT.w / 2} y={LEFT.y + 42} text-anchor="middle" style="font-weight: 700; fill: var(--fg)">{S.train[0]}</text>
    <text class="f-mut" x={LEFT.x + LEFT.w / 2} y={LEFT.y + 64} text-anchor="middle">{S.train[1]}</text>
    <text class="f-lbl" x={(LEFT.x + LEFT.w + MID.x) / 2} y="129" text-anchor="middle" style="font-size: 24px">→</text>

    <rect class="f-box" x={MID.x} y={TOP.y} width={MID.w} height={TOP.h} rx="12"></rect>
    <text class="f-mut" x={MID.x + 12} y={TOP.y + 22} text-anchor="start" style="font-weight: 700">{S.vocabTitle}</text>
    {
      vocabChips.map((c) => (
        <>
          <rect class="f-bar-bg" x={c.x} y={TOP.y + 36} width={c.w} height={CHIP_H} rx="7" />
          <text class="f-lbl" x={c.x + c.w / 2} y={TOP.y + 56} text-anchor="middle">
            {c.t}
          </text>
        </>
      ))
    }

    <rect class="f-box" x={MID.x} y={BOT.y} width={MID.w} height={BOT.h} rx="12"></rect>
    <text class="f-mut" x={MID.x + 12} y={BOT.y + 22} text-anchor="start" style="font-weight: 700">{S.rulesTitle}</text>
    {
      S.rules.map((r, i) => (
        <text class="f-lbl" x={MID.x + 16} y={BOT.y + 46 + i * 19} text-anchor="start" style="font-size: 13.5px">
          {r}
        </text>
      ))
    }

    <text class="f-lbl" x={(MID.x + MID.w + RIGHT.x) / 2} y="129" text-anchor="middle" style="font-size: 24px">→</text>
    <rect class="f-box" x={RIGHT.x} y={RIGHT.y} width={RIGHT.w} height={RIGHT.h} rx="12"></rect>
    {
      S.use.map((line, i) => (
        <text
          class={i === 0 ? 'f-mut' : 'f-mut'}
          x={RIGHT.x + RIGHT.w / 2}
          y={RIGHT.y + 30 + i * 22}
          text-anchor="middle"
          style={i === 0 ? 'font-weight: 700; fill: var(--fg)' : ''}
        >
          {line}
        </text>
      ))
    }
  </svg>
  <figcaption set:html={S.cap} />
</figure>
