---
// The whole BPE procedure on a short, natural text that is used in full. Row 0
// is the training text (the real one has billions of words). The text is cut
// at the punctuation marks, every remaining character becomes a piece, the
// pair that sits side by side most often is highlighted wherever it occurs (so
// the count can be checked by eye), then glued and added to the list, and the
// loop repeats. The chip rows are computed from the text, so the figure cannot
// drift from its own data.
interface Props {
  lang?: 'en' | 'ja';
}
const { lang = 'ja' } = Astro.props;

const S = {
  ja: {
    aria: 'BPE の手順：英語の短い 1 文を空白で語に分け、1 文字ずつに分け、一番多く隣り合うペア（a＋t、3 回）をくっつけて一覧表に登録し、繰り返す',
    passage: ['the cat sat on the mat'],
    chunks: ['the', 'cat', 'sat', 'on', 'the', 'mat'],
    rowGroups: [[0, 1, 2, 3, 4, 5]],
    pair: ['a', 't'],
    step0: '⓪ 学習データ（本物は何億語もある）。ここでは、この英語の 1 文を丸ごと使う',
    step1: '① 空白のところで語に分け、さらに 1 文字ずつに分ける',
    step2: '② 語の中で一番多く隣り合っているペアを探す → a ＋ t が 3 回',
    step3: '③ くっつけて、一覧表に登録する → 「at」を追加',
    repeat: '④ ② と ③ を繰り返す（次は t ＋ h、2 回）。本物は、一覧表が望みの大きさになるまで続ける',
    cap: 'BPE の手順はこれだけです。本物は何億語もの学習データで行いますが、ここでは英語の短い 1 文を丸ごと使います。②では語の中で隣り合っているペアを全部数え（語の境目はまたぎません）、「a ＋ t」が 3 回で一番多いので、くっつけた「at」を一覧表に加え、次に多いペア（t ＋ h、2 回）へ進みます。',
  },
  en: {
    aria: 'The BPE procedure: cut a short text into words, then into characters, glue the most frequent neighbouring pair (a + t, 3 times), add it to the list, repeat',
    passage: ['the cat sat on the mat'],
    chunks: ['the', 'cat', 'sat', 'on', 'the', 'mat'],
    rowGroups: [[0, 1, 2, 3, 4, 5]],
    pair: ['a', 't'],
    step0: '0. the training text (billions of words in reality; here, one sentence)',
    step1: '1. cut it into words at the spaces, then into characters',
    step2: '2. find the pair that sits side by side most often inside words → a + t, 3 times',
    step3: '3. glue it and add the result to the list → "at" joins the list',
    repeat: '4. repeat 2 and 3 (next: t + h, 2 times); for real, until the list is as big as you want',
    cap: 'That is the whole procedure. The real training text has billions of words; here it is one sentence, used in full. Step 2 counts every neighbouring pair inside the words (never across a word boundary); "a + t" wins with 3, so "at" joins the list, and the search moves on to the next most frequent pair (t + h, 2 times).',
  },
}[lang];

const CELL = 22;
const CELL_GAP = 3;
const CHUNK_GAP = 14;
const CHIP_H = 30;
const ROW_PITCH = 38;
const X0 = 16;
const [A, B] = S.pair;

interface Cell {
  t: string;
  x: number;
  w: number;
  hot: boolean;
}

// Row 0: the text itself, drawn as runs (a run is either text or a cut-point
// punctuation mark) so the browser spaces the letters within a run.
const TEXT_PX = 14;
const isPunct = (c: string) => c === '。' || c === '、';
const textW = (t: string) =>
  [...t].reduce((w, c) => w + (c === ' ' ? 4 : /[\u3000-\u9FFF\uFF00-\uFFEF]/.test(c) ? TEXT_PX : 7.5), 0);
const passageLines = S.passage.map((line) => {
  const runs: { t: string; x: number; punct: boolean }[] = [];
  for (const c of line) {
    const last = runs.at(-1);
    if (last && last.punct === isPunct(c)) {
      last.t += c;
    } else {
      runs.push({ t: c, x: 0, punct: isPunct(c) });
    }
  }
  let x = X0 + 4;
  for (const run of runs) {
    run.x = x;
    x += textW(run.t);
  }
  return runs;
});
const PASSAGE_Y = S.passage.map((_, i) => 44 + i * 22);

// Chip rows: each display row holds a few chunks; `isHot` marks highlighted cells.
const cellW = (t: string) => CELL + ([...t].length - 1) * (lang === 'ja' ? 16 : 8.5);
const layoutRow = (chunks: string[][], isHot: (t: string, toks: string[], i: number) => boolean): Cell[] => {
  const cells: Cell[] = [];
  let x = X0;
  chunks.forEach((toks, ci) => {
    toks.forEach((t, i) => {
      const w = cellW(t);
      cells.push({ t, x, w, hot: isHot(t, toks, i) });
      x += w + CELL_GAP;
    });
    x += ci < chunks.length - 1 ? CHUNK_GAP - CELL_GAP : 0;
  });
  return cells;
};
const merge = (toks: string[]): string[] => {
  const out: string[] = [];
  for (let i = 0; i < toks.length; i += 1) {
    if (toks[i] === A && toks[i + 1] === B) {
      out.push(A + B);
      i += 1;
    } else {
      out.push(toks[i]);
    }
  }
  return out;
};
const isPair = (t: string, toks: string[], i: number) =>
  (t === A && toks[i + 1] === B) || (t === B && toks[i - 1] === A);

const chars = S.chunks.map((c) => [...c]);
const merged = chars.map((toks) => merge(toks));
const pick = (all: string[][], group: number[]) => group.map((i) => all[i]);
const Y_BLOCK1 = (PASSAGE_Y.at(-1) ?? 44) + 58;
const block1 = S.rowGroups.map((g, r) => ({ y: Y_BLOCK1 + r * ROW_PITCH, cells: layoutRow(pick(chars, g), isPair) }));
const Y_BLOCK2 = Y_BLOCK1 + S.rowGroups.length * ROW_PITCH + 26;
const block2 = S.rowGroups.map((g, r) => ({ y: Y_BLOCK2 + r * ROW_PITCH, cells: layoutRow(pick(merged, g), (t) => t === A + B) }));
const REPEAT_Y = Y_BLOCK2 + S.rowGroups.length * ROW_PITCH + 22;
const HEIGHT = REPEAT_Y + 16;
---

<figure class="figure">
  <svg viewBox={`0 0 600 ${HEIGHT}`} role="img" aria-label={S.aria}>
    <text class="f-mut" x={X0} y="22" text-anchor="start" style="font-weight: 700">{S.step0}</text>
    {
      passageLines.map((line, li) =>
        line.map((run) => (
          <text
            class={run.punct ? 'f-mut' : 'f-lbl'}
            x={run.x}
            y={PASSAGE_Y[li]}
            text-anchor="start"
            style={`font-size: ${TEXT_PX}px${run.punct ? '; font-weight: 700' : ''}`}
          >
            {run.t}
          </text>
        )),
      )
    }

    <text class="f-mut" x={X0} y={Y_BLOCK1 - 28} text-anchor="start" style="font-weight: 700">{S.step1}</text>
    <text class="f-mut" x={X0} y={Y_BLOCK1 - 8} text-anchor="start" style="font-weight: 700">{S.step2}</text>
    {
      block1.map((row) =>
        row.cells.map((c) => (
          <>
            <rect class={c.hot ? 'f-bar-bg' : 'f-box'} x={c.x} y={row.y} width={c.w} height={CHIP_H} rx="6" />
            <text class="f-lbl" x={c.x + c.w / 2} y={row.y + 20} text-anchor="middle">
              {c.t}
            </text>
          </>
        )),
      )
    }

    <text class="f-mut" x={X0} y={Y_BLOCK2 - 8} text-anchor="start" style="font-weight: 700">{S.step3}</text>
    {
      block2.map((row) =>
        row.cells.map((c) => (
          <>
            <rect class={c.hot ? 'f-bar-bg' : 'f-box'} x={c.x} y={row.y} width={c.w} height={CHIP_H} rx="6" />
            <text class="f-lbl" x={c.x + c.w / 2} y={row.y + 20} text-anchor="middle">
              {c.t}
            </text>
          </>
        )),
      )
    }

    <text class="f-mut" x={X0} y={REPEAT_Y} text-anchor="start" style="font-weight: 700">{S.repeat}</text>
  </svg>
  <figcaption set:html={S.cap} />
</figure>
