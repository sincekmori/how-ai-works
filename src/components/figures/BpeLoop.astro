---
// The whole BPE procedure on a small, fully visible example. Row 0 shows the
// training text (a short list; the real one has billions of words), and every
// word of it is used from then on: split the words into
// characters, find the pair that sits side by side most often (every
// occurrence is highlighted, so the count can be checked by eye), glue it and
// add the result to the list, repeat. Rows 2 and 3 are computed from the
// words so the figure cannot drift from its own data.
interface Props {
  lang?: 'en' | 'ja';
}
const { lang = 'ja' } = Astro.props;

interface Segment {
  t: string;
  hot?: boolean;
}

const S = {
  ja: {
    aria: 'BPE の手順：短い文章を読点で語に分け、1 文字ずつに分け、一番多く隣り合うペア（東＋京、4 回）をくっつけて一覧表に登録し、繰り返す',
    passage: [
      [
        { t: '行ってみたい場所：' },
        { t: '東京', hot: true },
        { t: '、' },
        { t: '京都', hot: true },
        { t: '、' },
        { t: '東京駅', hot: true },
        { t: '、' },
        { t: '京都駅', hot: true },
        { t: '、' },
        { t: '東京都庁', hot: true },
        { t: '、' },
        { t: '東京湾', hot: true },
      ],
    ] as Segment[][],
    words: ['東京', '京都', '東京駅', '京都駅', '東京都庁', '東京湾'],
    pair: ['東', '京'],
    step0: '⓪ 学習データ（本物は何億語もある）。ここでは、この短い文章を丸ごと使う',
    step1: '① 読点（、）で語に分け、さらに 1 文字ずつに分ける',
    step2: '② 語の中で一番多く隣り合っているペアを探す（語の境目はまたがない）→ 東 ＋ 京 が 4 回',
    step3: '③ くっつけて、一覧表に登録する → 「東京」を追加',
    repeat: '④ ② と ③ を繰り返す（次は 京 ＋ 都、2 回）。本物は、一覧表が望みの大きさになるまで続ける',
    cap: 'BPE の手順はこれだけです。本物は何億語もの学習データで行いますが、ここでは短い文章を丸ごと使います。②では語の中で隣り合っているペアを全部数え、「東 ＋ 京」が 4 回で一番多いので、くっつけた「東京」を一覧表に加え、次に多いペア（京 ＋ 都、2 回）へ進みます。',
  },
  en: {
    aria: 'The BPE procedure: take the words of a short training text, split them into characters, glue the most frequent neighbouring pair (a + t, 3 times), add it to the list, repeat',
    passage: [
      [
        { t: 'the', hot: true },
        { t: ' ' },
        { t: 'cat', hot: true },
        { t: ' ' },
        { t: 'sat', hot: true },
        { t: ' ' },
        { t: 'on', hot: true },
        { t: ' ' },
        { t: 'the', hot: true },
        { t: ' ' },
        { t: 'mat', hot: true },
        { t: '.' },
      ],
    ] as Segment[][],
    words: ['the', 'cat', 'sat', 'on', 'the', 'mat'],
    pair: ['a', 't'],
    step0: '0. the training text (billions of words in reality; here, one sentence)',
    step1: '1. cut it into words at the spaces, then into characters',
    step2: '2. find the pair that sits side by side most often inside words (never across a boundary) → a + t, 3 times',
    step3: '3. glue it and add the result to the list → "at" joins the list',
    repeat: '4. repeat 2 and 3 (next: t + h, 2 times); for real, until the list is as big as you want',
    cap: 'That is the whole procedure. The real training text has billions of words; here it is one sentence. Step 2 counts every neighbouring pair inside the words; "a + t" wins with 3, so "at" joins the list, and the search moves on to the next most frequent pair (t + h, 2 times).',
  },
}[lang];

const CELL = lang === 'ja' ? 28 : 22;
const CELL_GAP = 3;
const WORD_GAP = 12;
const CHIP_H = 30;
const X0 = 16;
const [A, B] = S.pair;

interface Cell {
  t: string;
  x: number;
  w: number;
  hot: boolean;
}

// Running text (row 0): estimated glyph widths at 14px.
const TEXT_PX = 14;
const textW = (t: string) => [...t].reduce((w, c) => w + (c === ' ' ? 9 : /[\u3000-\u9FFF\uFF00-\uFFEF]/.test(c) ? TEXT_PX : 7.5), 0);
const passageLines = S.passage.map((line) => {
  let x = X0 + 4;
  return line.map((seg) => {
    const w = textW(seg.t);
    const out = { t: seg.t, hot: seg.hot === true, x, w };
    x += w;
    return out;
  });
});
const PASSAGE_Y = [44];

// Chip rows (1 to 3); `isHot` decides which cells are highlighted.
const cellW = (t: string) => CELL + ([...t].length - 1) * (lang === 'ja' ? 16 : 8.5);
const layout = (words: string[][], isHot: (t: string, toks: string[], i: number) => boolean): Cell[] => {
  const cells: Cell[] = [];
  let x = X0;
  words.forEach((toks, wi) => {
    toks.forEach((t, i) => {
      const w = cellW(t);
      cells.push({ t, x, w, hot: isHot(t, toks, i) });
      x += w + CELL_GAP;
    });
    x += wi < words.length - 1 ? WORD_GAP - CELL_GAP : 0;
  });
  return cells;
};
const merge = (toks: string[]): string[] => {
  const out: string[] = [];
  for (let i = 0; i < toks.length; i += 1) {
    if (toks[i] === A && toks[i + 1] === B) {
      out.push(A + B);
      i += 1;
    } else {
      out.push(toks[i]);
    }
  }
  return out;
};

const chars = S.words.map((w) => [...w]);
const isPair = (t: string, toks: string[], i: number) =>
  (t === A && toks[i + 1] === B) || (t === B && toks[i - 1] === A);
const ROW_Y = [84, 154, 224];
const rows = [
  { label: S.step1, cells: layout(chars, () => false), y: ROW_Y[0] },
  { label: S.step2, cells: layout(chars, isPair), y: ROW_Y[1] },
  { label: S.step3, cells: layout(chars.map((w) => merge(w)), (t) => t === A + B), y: ROW_Y[2] },
];
const REPEAT_Y = ROW_Y[2] + 66;
const HEIGHT = REPEAT_Y + 16;
---

<figure class="figure">
  <svg viewBox={`0 0 600 ${HEIGHT}`} role="img" aria-label={S.aria}>
    <text class="f-mut" x={X0} y="22" text-anchor="start" style="font-weight: 700">{S.step0}</text>
    {
      passageLines.map((line, li) => (
        <>
          {line
            .filter((seg) => seg.hot)
            .map((seg) => (
              <rect class="f-bar-bg" x={seg.x - 3} y={PASSAGE_Y[li] - 15} width={seg.w + 6} height="21" rx="5" />
            ))}
          {line.map((seg) => (
            <text
              class={seg.hot ? 'f-lbl' : 'f-mut'}
              x={seg.x}
              y={PASSAGE_Y[li]}
              text-anchor="start"
              style={`font-size: ${TEXT_PX}px${seg.hot ? '; font-weight: 700' : ''}`}
            >
              {seg.t}
            </text>
          ))}
        </>
      ))
    }
    {
      rows.map((row) => (
        <>
          <text class="f-mut" x={X0} y={row.y - 8} text-anchor="start" style="font-weight: 700">
            {row.label}
          </text>
          {row.cells.map((c) => (
            <>
              <rect class={c.hot ? 'f-bar-bg' : 'f-box'} x={c.x} y={row.y} width={c.w} height={CHIP_H} rx="6" />
              <text class="f-lbl" x={c.x + c.w / 2} y={row.y + 20} text-anchor="middle">
                {c.t}
              </text>
            </>
          ))}
        </>
      ))
    }
    <text class="f-mut" x={X0} y={REPEAT_Y} text-anchor="start" style="font-weight: 700">{S.repeat}</text>
  </svg>
  <figcaption set:html={S.cap} />
</figure>
