---
// BPE leaves behind an ORDERED list of merge rules, not only a list of pieces.
// A new word is split by replaying the rules in that order; replaying them in
// another order can give a different split. The fixed order is what makes every
// split reproducible, i.e. the same split the model saw during training.
import { CHIP_H, chipsCentred } from '../../lib/chips';

interface Props {
  lang?: 'en' | 'ja';
}
const { lang = 'ja' } = Astro.props;

interface Step {
  label: string;
  toks: string[];
}
interface Column {
  head: string;
  steps: Step[];
  result: string;
}

const S = {
  ja: {
    aria: '同じ語でも、ルールを当てはめる順番で区切り方が変わる例',
    top: '新しい語「東京都」を、覚えたルールで区切る',
    start: ['東', '京', '都'],
    cols: [
      {
        head: '学習した順番どおり',
        steps: [
          { label: 'ルール 1：東 ＋ 京 → 東京', toks: ['東京', '都'] },
          { label: 'ルール 2（京 ＋ 都）：当てはまらない', toks: ['東京', '都'] },
        ],
        result: '東京の「都」',
      },
      {
        head: 'もし順番を無視したら',
        steps: [
          { label: '先にルール 2：京 ＋ 都 → 京都', toks: ['東', '京都'] },
          { label: 'ルール 1（東 ＋ 京）：当てはまらない', toks: ['東', '京都'] },
        ],
        result: '東と「京都」',
      },
    ] as Column[],
    bottom: '順番を決めておけば、区切り方はいつも一通りに決まる。',
    cap: 'BPE が残すのは部品の一覧表だけでなく、<strong>どの順番でくっつけたか</strong> というルールの列です。新しい語を区切るときは、ルールを覚えたときと同じ順番で当てはめます。順番を変えると「東京｜都」が「東｜京都」になり、読み方まで変わってしまいます。大事なのは、モデルが学習データで見ていたのと同じ区切り方に毎回なることです。',
  },
  en: {
    aria: 'The same word splits differently depending on the order the rules are applied in',
    top: 'Splitting the new word "math" with the learned rules',
    start: ['m', 'a', 't', 'h'],
    cols: [
      {
        head: 'In the learned order',
        steps: [
          { label: 'rule 1: a + t → at', toks: ['m', 'at', 'h'] },
          { label: 'rule 2 (t + h): no "t" before "h", so nothing', toks: ['m', 'at', 'h'] },
        ],
        result: 'm | at | h',
      },
      {
        head: 'If the order were ignored',
        steps: [
          { label: 'rule 2 first: t + h → th', toks: ['m', 'a', 'th'] },
          { label: 'rule 1 (a + t): no "t" after "a", so nothing', toks: ['m', 'a', 'th'] },
        ],
        result: 'm | a | th',
      },
    ] as Column[],
    bottom: 'With a fixed order, every split comes out the same way.',
    cap: 'BPE leaves behind more than a list of pieces: it also leaves <strong>the order in which the pairs were glued</strong>. A new word is split by replaying the rules in that same order. Replaying them in another order gives a different split ("m | at | h" versus "m | a | th"), so what matters is that the answer comes out the same every time: exactly the split the model saw in its training text.',
  },
}[lang];

const colX = [150, 450];
const Y_START = 42;
const Y_HEAD = 108;
const Y_STEP = [132, 198];
const Y_RESULT = 268;
---

<figure class="figure">
  <svg viewBox="0 0 600 320" role="img" aria-label={S.aria}>
    <text class="f-lbl" x="300" y="24" text-anchor="middle">{S.top}</text>
    {
      chipsCentred(S.start, 300).map((c) => (
        <>
          <rect class="f-bar-bg" x={c.x} y={Y_START} width={c.w} height={CHIP_H} rx="7" />
          <text class="f-lbl" x={c.x + c.w / 2} y={Y_START + 20} text-anchor="middle">
            {c.t}
          </text>
        </>
      ))
    }
    <path class="f-axis" d={`M 300 ${Y_START + CHIP_H + 4} L 150 ${Y_HEAD - 18}`}></path>
    <path class="f-axis" d={`M 300 ${Y_START + CHIP_H + 4} L 450 ${Y_HEAD - 18}`}></path>

    {
      S.cols.map((col, ci) => (
        <>
          <text class="f-lbl" x={colX[ci]} y={Y_HEAD} text-anchor="middle" style="font-weight: 700">
            {col.head}
          </text>
          {col.steps.map((s, si) => (
            <>
              <text class="f-mut" x={colX[ci]} y={Y_STEP[si]} text-anchor="middle">
                {s.label}
              </text>
              {chipsCentred(s.toks, colX[ci]).map((c) => (
                <>
                  <rect class="f-box" x={c.x} y={Y_STEP[si] + 10} width={c.w} height={CHIP_H} rx="7" />
                  <text class="f-lbl" x={c.x + c.w / 2} y={Y_STEP[si] + 30} text-anchor="middle">
                    {c.t}
                  </text>
                </>
              ))}
            </>
          ))}
          <text class="f-lbl" x={colX[ci]} y={Y_RESULT} text-anchor="middle" style="font-weight: 700">
            {col.result}
          </text>
        </>
      ))
    }

    <text class="f-mut" x="300" y="304" text-anchor="middle">{S.bottom}</text>
  </svg>
  <figcaption set:html={S.cap} />
</figure>
