---
// The old way: read one word at a time, carrying a small "memo" (hidden state)
// forward. Each step: take the running memo + the new word -> updated memo.
interface Props {
  lang?: 'en' | 'ja';
}
const { lang = 'ja' } = Astro.props;
const xs = [80, 200, 320, 440, 560];
const S = {
  ja: {
    intro: '左から順に 1 語ずつ。読むたびに「メモ」を更新して、次へ持ち越す。',
    memo: 'メモ',
    words: ['私', 'は', '海', 'が', '好き'],
    cap: '昔の言語モデルは、文を <strong>一語ずつ順番に</strong> 読みました。読むたびに「これまでの内容のまとめ」を小さな<strong>メモ</strong>に書き直し、それを次の単語へ持ち越していきます。この「前の結果を次に持ち越す」やり方を <strong>再帰（リカレント）</strong>、持ち越されるメモのことを <strong>隠れ状態</strong> と呼びます。',
  },
  en: {
    intro: 'Left to right, one word at a time. Each step updates the "memo" and carries it forward.',
    memo: 'memo',
    words: ['I', 'really', 'love', 'the', 'sea'],
    cap: 'Old language models read a sentence <strong>one word at a time, in order</strong>. At each word they rewrite a small <strong>memo</strong> — a summary of the story so far — and carry it to the next word. This "pass the result forward" approach is called <strong>recurrence</strong>, and the carried memo is the <strong>hidden state</strong>.',
  },
}[lang];
const {words} = S;
---

<figure class="figure">
  <svg viewBox="0 0 640 240" role="img" aria-label="Reading one word at a time, carrying a memo forward">
    <defs>
      <marker id="rc-arrow" markerWidth="9" markerHeight="9" refX="6" refY="3" orient="auto">
        <path d="M0,0 L6,3 L0,6 Z" style="fill: var(--fg-muted)"></path>
      </marker>
    </defs>

    <text class="f-mut" x="320" y="22" text-anchor="middle">{S.intro}</text>

    <!-- carry arrows between memos -->
    {
      xs.slice(0, -1).map((x, i) => (
        <line
          class="f-axis"
          x1={x + 34}
          y1="95"
          x2={xs[i + 1] - 34}
          y2="95"
          marker-end="url(#rc-arrow)"
        />
      ))
    }

    <!-- memo boxes -->
    {
      xs.map((x) => (
        <>
          <rect class="f-box" x={x - 34} y="72" width="68" height="46" rx="10" />
          <text class="f-mut" x={x} y="100" text-anchor="middle">
            {S.memo}
          </text>
        </>
      ))
    }

    <!-- input arrows word -> memo -->
    {
      xs.map((x) => (
        <line class="f-axis" x1={x} y1="168" x2={x} y2="122" marker-end="url(#rc-arrow)" />
      ))
    }

    <!-- word chips -->
    {
      xs.map((x, i) => (
        <>
          <rect class="f-bar-bg" x={x - 30} y="172" width="60" height="38" rx="9" />
          <text class="f-lbl" x={x} y="196" text-anchor="middle">
            {words[i]}
          </text>
        </>
      ))
    }
  </svg>
  <figcaption set:html={S.cap} />
</figure>
