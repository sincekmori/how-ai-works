---
// "Ask AI" dropdown: deep-links to ChatGPT / Gemini / Claude with a prompt that
// points the model at this page's clean Markdown (.md) and asks it to fact-check
// the explainer and cite authoritative sources. This gives readers — including
// experts — a one-click way to verify accuracy and find references, without the
// author having to be a domain authority. Self-contained (no library); reuses the
// ShareBar dropdown styles (.share*), and the ShareBar script (present on the same
// page) handles close-on-outside / Escape.
interface Props {
  mdUrl: string; // absolute URL of the page's .md
  title: string;
  lang?: 'en' | 'ja';
}
const { mdUrl, title, lang = 'en' } = Astro.props;
const enc = encodeURIComponent;

const L = {
  en: {
    label: 'Ask AI',
    prompt: `I'm reading a beginner-friendly explainer titled "${title}". Please read it at ${mdUrl} then help me check its accuracy: point out anything wrong or oversimplified, and add authoritative sources (papers or books) I can verify.`,
  },
  ja: {
    label: 'AI に聞く',
    prompt: `「${title}」という初心者向けの解説を読んでいます。${mdUrl} を読んでから、内容の正確性を確認し、誤りや単純化しすぎがあれば指摘し、確認できる出典（論文・書籍）を挙げてください。`,
  },
}[lang];

// Brand icons. Gemini and Claude marks are from simple-icons (CC0 icon data).
// OpenAI's logo was removed from simple-icons at the company's request, so for
// ChatGPT we use a neutral chat-bubble glyph in its signature colour instead.
const ICON: Record<string, string> = {
  ChatGPT:
    '<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#10A37F" d="M12 3C6.477 3 2 6.64 2 11.04c0 2.39 1.32 4.53 3.4 5.99-.11 1.07-.55 2.16-1.27 3.04-.26.32-.03.8.38.74 1.86-.26 3.5-1.02 4.66-2.06.56.11 1.14.17 1.83.17 5.52 0 10-3.64 10-8.04C22 6.64 17.52 3 12 3Z"/></svg>',
  Gemini:
    '<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M11.04 19.32Q12 21.51 12 24q0-2.49.93-4.68.96-2.19 2.58-3.81t3.81-2.55Q21.51 12 24 12q-2.49 0-4.68-.93a12.3 12.3 0 0 1-3.81-2.58 12.3 12.3 0 0 1-2.58-3.81Q12 2.49 12 0q0 2.49-.96 4.68-.93 2.19-2.55 3.81a12.3 12.3 0 0 1-3.81 2.58Q2.49 12 0 12q2.49 0 4.68.96 2.19.93 3.81 2.55t2.55 3.81"/></svg>',
  Claude:
    '<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#D97757" d="m4.7144 15.9555 4.7174-2.6471.079-.2307-.079-.1275h-.2307l-.7893-.0486-2.6956-.0729-2.3375-.0971-2.2646-.1214-.5707-.1215-.5343-.7042.0546-.3522.4797-.3218.686.0608 1.5179.1032 2.2767.1578 1.6514.0972 2.4468.255h.3886l.0546-.1579-.1336-.0971-.1032-.0972L6.973 9.8356l-2.55-1.6879-1.3356-.9714-.7225-.4918-.3643-.4614-.1578-1.0078.6557-.7225.8803.0607.2246.0607.8925.686 1.9064 1.4754 2.4893 1.8336.3643.3035.1457-.1032.0182-.0728-.164-.2733-1.3539-2.4467-1.445-2.4893-.6435-1.032-.17-.6194c-.0607-.255-.1032-.4674-.1032-.7285L6.287.1335 6.6997 0l.9957.1336.419.3642.6192 1.4147 1.0018 2.2282 1.5543 3.0296.4553.8985.2429.8318.091.255h.1579v-.1457l.1275-1.706.2368-2.0947.2307-2.6957.0789-.7589.3764-.9107.7468-.4918.5828.2793.4797.686-.0668.4433-.2853 1.8517-.5586 2.9021-.3643 1.9429h.2125l.2429-.2429.9835-1.3053 1.6514-2.0643.7286-.8196.85-.9046.5464-.4311h1.0321l.759 1.1293-.34 1.1657-1.0625 1.3478-.8804 1.1414-1.2628 1.7-.7893 1.36.0729.1093.1882-.0183 2.8535-.607 1.5421-.2794 1.8396-.3157.8318.3886.091.3946-.3278.8075-1.967.4857-2.3072.4614-3.4364.8136-.0425.0304.0486.0607 1.5482.1457.6618.0364h1.621l3.0175.2247.7892.522.4736.6376-.079.4857-1.2142.6193-1.6393-.3886-3.825-.9107-1.3113-.3279h-.1822v.1093l1.0929 1.0686 2.0035 1.8092 2.5075 2.3314.1275.5768-.3218.4554-.34-.0486-2.2039-1.6575-.85-.7468-1.9246-1.621h-.1275v.17l.4432.6496 2.3436 3.5214.1214 1.0807-.17.3521-.6071.2125-.6679-.1214-1.3721-1.9246L14.38 17.959l-1.1414-1.9428-.1397.079-.674 7.2552-.3156.3703-.7286.2793-.6071-.4614-.3218-.7468.3218-1.4753.3886-1.9246.3157-1.53.2853-1.9004.17-.6314-.0121-.0425-.1397.0182-1.4328 1.9672-2.1796 2.9446-1.7243 1.8456-.4128.164-.7164-.3704.0667-.6618.4008-.5889 2.386-3.0357 1.4389-1.882.929-1.0868-.0062-.1579h-.0546l-6.3385 4.1164-1.1293.1457-.4857-.4554.0608-.7467.2307-.2429 1.9064-1.3114Z"/></svg>',
};

const links = [
  { name: 'ChatGPT', href: `https://chatgpt.com/?hints=search&q=${enc(L.prompt)}` },
  { name: 'Gemini', href: `https://gemini.google.com/app?q=${enc(L.prompt)}` },
  { name: 'Claude', href: `https://claude.ai/new?q=${enc(L.prompt)}` },
];
---

<details class="share askai">
  <summary class="share__toggle btn">✨ {L.label}</summary>
  <div class="share__menu">
    {
      links.map((l) => (
        <a class="share__item" href={l.href} target="_blank" rel="noopener noreferrer">
          <span class="share__ico" set:html={ICON[l.name]} />
          {l.name}
        </a>
      ))
    }
  </div>
</details>
