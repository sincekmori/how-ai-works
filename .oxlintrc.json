{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "env": { "browser": true, "es2024": true },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "pedantic": "warn",
    "style": "warn",
    "restriction": "off",
    "nursery": "off"
  },
  "rules": {
    "typescript/triple-slash-reference": "off",
    "unicorn/filename-case": "off",
    "unicorn/no-null": "off",
    "unicorn/prefer-global-this": "off",
    "unicorn/no-nested-ternary": "off",
    "unicorn/consistent-function-scoping": "off",
    "unicorn/prefer-single-call": "off",
    "unicorn/no-immediate-mutation": "off",
    "no-magic-numbers": "off",
    "id-length": "off",
    "capitalized-comments": "off",
    "no-inline-comments": "off",
    "sort-keys": "off",
    "sort-imports": "off",
    "no-ternary": "off",
    "no-nested-ternary": "off",
    "func-style": "off",
    "func-names": "off",
    "max-statements": "off",
    "vars-on-top": "off",
    "no-continue": "off",
    "require-unicode-regexp": "off"
  },
  "overrides": [
    {
      "files": ["src/lib/references.ts"],
      "rules": {
        // Pure data (one entry per chapter reference); its length grows with the
        // curriculum and says nothing about code complexity.
        "max-lines": "off"
      }
    },
    {
      "files": ["**/*.svelte"],
      "rules": {
        // oxlint cannot see reassignments made from Svelte templates (bind:value,
        // onclick={() => (x = ...)}), so prefer-const on `let x = $state(...)` is a
        // false positive. Auto-applying it breaks the build with constant_binding.
        "prefer-const": "off"
      }
    }
  ]
}
